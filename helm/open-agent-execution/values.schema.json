{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "enum": [
        "test",
        "prod"
      ]
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "executorNamespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "configurationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "imagePullSecrets": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
      }
    },
    "supervisor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "temporalSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "caConfigMap": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "nodePool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "$ref": "#/definitions/quantities"
            },
            "limits": {
              "$ref": "#/definitions/quantities"
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        },
        "disruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          },
          "required": [
            "enabled",
            "minAvailable"
          ]
        }
      },
      "required": [
        "replicas",
        "existingSecret",
        "temporalSecret",
        "caConfigMap",
        "nodePool",
        "resources",
        "disruptionBudget"
      ]
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceAccount": {
          "const": "open-agent-executor"
        },
        "workerSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "caConfigMap": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "nodePool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "imagePullSecrets": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "maximumPods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      },
      "required": [
        "serviceAccount",
        "workerSecret",
        "caConfigMap",
        "nodePool",
        "imagePullSecrets",
        "maximumPods"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dns": {
          "$ref": "#/definitions/podPeer"
        },
        "control": {
          "$ref": "#/definitions/dependency"
        },
        "temporal": {
          "$ref": "#/definitions/dependency"
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/dependency"
          }
        },
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "addresses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?:10\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(?:1[6-9]|2[0-9]|3[01])|192\\.168)\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              }
            },
            "ports": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "required": [
            "addresses",
            "ports"
          ]
        }
      },
      "required": [
        "dns",
        "control",
        "temporal",
        "models",
        "kubernetes"
      ]
    }
  },
  "required": [
    "environment",
    "namespace",
    "executorNamespace",
    "configurationRevision",
    "image",
    "imagePullSecrets",
    "supervisor",
    "executor",
    "network"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+(?::[0-9]{1,5})?/[a-z0-9][a-z0-9._/-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "quantities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]+)$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(?:Mi|Gi)$"
        }
      },
      "required": [
        "cpu",
        "memory"
      ]
    },
    "podPeer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "podLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          }
        }
      },
      "required": [
        "namespace",
        "podLabels"
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ports"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "podLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          }
        },
        "cidr": {
          "type": "string",
          "pattern": "^(?:10\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[89]|[12][0-9]|3[0-2])|172\\.(?:1[6-9]|2[0-9]|3[01])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:1[2-9]|2[0-9]|3[0-2])|192\\.168\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:1[6-9]|2[0-9]|3[0-2]))$"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "namespace",
            "podLabels"
          ],
          "not": {
            "required": [
              "cidr"
            ]
          }
        },
        {
          "required": [
            "cidr"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "podLabels"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
